{
  "description": "Post and read messages; route replies; forward selected conversations",
  "command": "./slack.ts",
  "form": "args",
  "serves": "itself",
  "processes": 1,
  "tags": [
    "messaging"
  ],
  "needs": {
    "network": [
      "slack.com",
      "*.slack.com"
    ]
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "author": "Serg Parf and agent-bus contributors",
  "homepage": "https://parf.dev/agent-bus/",
  "methods": {
    "post": {
      "help": "Post a message or reply in a thread",
      "args": [
        {
          "name": "channel"
        },
        {
          "name": "thread_ts",
          "type": "string",
          "help": "Reply in this Slack thread (JSON only)",
          "optional": true,
          "json_only": true
        },
        {
          "name": "username",
          "type": "string",
          "help": "Override this post’s display name (JSON only)",
          "optional": true,
          "json_only": true
        },
        {
          "name": "icon",
          "type": "string",
          "help": "Emoji name or image URL (JSON only)",
          "optional": true,
          "json_only": true
        },
        {
          "name": "text",
          "type": "string",
          "help": "Message text",
          "rest": true
        }
      ],
      "returns": "the message permalink",
      "example": "agent-bus call '#slack@parf.us' 'post #general Hello team'"
    },
    "read": {
      "help": "Read messages oldest first",
      "args": [
        {
          "name": "channel"
        },
        {
          "name": "limit",
          "optional": true
        }
      ],
      "returns": "Messages with timestamp, user and text",
      "example": "agent-bus call '#slack@parf.us' 'read #general 10'"
    },
    "thread": {
      "help": "Read one thread oldest first",
      "args": [
        {
          "name": "channel"
        },
        {
          "name": "ts"
        },
        {
          "name": "limit",
          "optional": true
        }
      ],
      "example": "agent-bus call '#slack@parf.us' 'thread #alerts 1710000000.000001 5'"
    },
    "channels": {
      "help": "List channels; optional name substring filter",
      "args": [
        {
          "name": "filter",
          "type": "string",
          "help": "Channel name substring",
          "optional": true
        },
        {
          "name": "member_only",
          "type": "bool",
          "help": "Only channels the bot joined (JSON only)",
          "optional": true,
          "json_only": true
        }
      ],
      "example": "agent-bus call '#slack@parf.us' 'channels alerts'"
    },
    "channel": {
      "help": "Describe one channel",
      "args": [
        {
          "name": "channel"
        }
      ],
      "example": "agent-bus call '#slack@parf.us' 'channel #alerts'"
    },
    "users": {
      "help": "List people; excludes bots and deleted accounts",
      "args": [
        {
          "name": "filter",
          "type": "string",
          "help": "Match name, email or ID",
          "optional": true
        }
      ],
      "example": "agent-bus call '#slack@parf.us' 'users Alice'"
    },
    "user": {
      "help": "Describe a person or bot",
      "args": [
        {
          "name": "who",
          "type": "string",
          "help": "User ID, email or @name"
        }
      ],
      "example": "agent-bus call '#slack@parf.us' 'user @alice'"
    },
    "react": {
      "help": "Add a reaction",
      "args": [
        {
          "name": "channel"
        },
        {
          "name": "ts"
        },
        {
          "name": "emoji",
          "type": "string",
          "help": "Slack emoji name, for example white_check_mark"
        }
      ],
      "example": "agent-bus call '#slack@parf.us' 'react #alerts 1710000000.000001 thumbsup'"
    },
    "edit": {
      "help": "Edit the bot’s own message",
      "args": [
        {
          "name": "channel"
        },
        {
          "name": "ts"
        },
        {
          "name": "text",
          "type": "string",
          "help": "Replacement text",
          "rest": true
        }
      ],
      "destructive": true,
      "example": "agent-bus call '#slack@parf.us' 'edit #alerts 1710000000.000001 Deploy finished'"
    },
    "delete": {
      "help": "Delete the bot’s own message",
      "args": [
        {
          "name": "channel"
        },
        {
          "name": "ts"
        }
      ],
      "destructive": true,
      "example": "agent-bus call '#slack@parf.us' 'delete #alerts 1710000000.000001'"
    },
    "join": {
      "help": "Join a public Slack channel",
      "args": [
        {
          "name": "channel"
        }
      ],
      "example": "agent-bus call '#slack@parf.us' 'join #alerts'"
    },
    "whoami": {
      "help": "Show bot identity, workspace and connection state",
      "args": [],
      "example": "agent-bus call '#slack@parf.us' whoami"
    },
    "refused": {
      "help": "List the last 20 unlisted routing senders; direct Owner/Maintainers only",
      "args": [],
      "role": "maintainer",
      "example": "agent-bus call '#slack@parf.us' refused"
    },
    "sub.add": {
      "help": "Forward matching messages to a destination",
      "args": [
        {
          "name": "channel"
        },
        {
          "name": "target"
        },
        {
          "name": "from_users",
          "optional": true
        },
        {
          "name": "filter",
          "optional": true,
          "rest": true
        }
      ],
      "returns": "Subscription ID",
      "text": "sub add <channel> <target> [from=user,…] [filter]",
      "example": "agent-bus call '#slack@parf.us' 'sub add #alerts #debug@parf.us /error/i'"
    },
    "sub.list": {
      "help": "Show subscriptions, authors, filters and delivery counters",
      "args": [],
      "text": "sub list",
      "example": "agent-bus call '#slack@parf.us' 'sub list'"
    },
    "sub.edit": {
      "help": "Update a subscription; empty filter= clears its filter",
      "args": [
        {
          "name": "id"
        },
        {
          "name": "channel",
          "optional": true
        },
        {
          "name": "target",
          "optional": true
        },
        {
          "name": "from_users",
          "optional": true
        },
        {
          "name": "filter",
          "optional": true,
          "rest": true
        }
      ],
      "text": "sub edit <id> [channel=…] [target=…] [from=…] [filter=…]",
      "example": "agent-bus call '#slack@parf.us' 'sub edit s1 filter=/error/i'"
    },
    "sub.delete": {
      "help": "Stop forwarding",
      "args": [
        {
          "name": "id"
        }
      ],
      "destructive": true,
      "text": "sub delete <id>",
      "example": "agent-bus call '#slack@parf.us' 'sub delete s1'"
    },
    "help": {
      "help": "Describe this agent and the help-config and help-secret asks",
      "args": []
    }
  },
  "config": {
    "users": {
      "type": "json",
      "help": "Listed platform user ID → bus user; unlisted users are refused",
      "example": {
        "U012ABC": "parf"
      }
    },
    "tags": {
      "type": "json",
      "help": "Pinned short tag → session agent; generated tags are permanent",
      "example": {
        "b": "#claude/main@parf.us"
      }
    },
    "route": {
      "type": "string",
      "help": "Fallback bus destination for admitted, addressed messages",
      "example": "#claude/main@parf.us"
    },
    "channels": {
      "type": "json",
      "help": "Channel ID or #name → route, tags:false and/or anyone:true; or handler:drop alone to discard incoming messages and subscriptions (post still works)",
      "example": {
        "#ops": {
          "route": "#claude/main@parf.us",
          "tags": false,
          "anyone": true
        }
      }
    }
  },
  "arguments": {
    "limit": {
      "type": "int",
      "help": "Number of messages, 1..200; default 20"
    },
    "id": {
      "type": "string",
      "help": "Subscription ID"
    },
    "channel": {
      "type": "string",
      "help": "Slack #channel, channel ID or user email for a DM"
    },
    "target": {
      "type": "string",
      "help": "Bus destination; you must manage it, or be this agent’s direct Owner/Maintainer"
    },
    "from_users": {
      "type": "list",
      "help": "Author IDs, emails, @names or bot IDs; text uses from= before filter"
    },
    "ts": {
      "type": "string",
      "help": "Message or thread timestamp"
    },
    "filter": {
      "type": "string",
      "help": "Regex /pattern/flags or plain regex; empty filter= clears an edited subscription"
    }
  },
  "body_formats": [
    "text",
    "json"
  ]
}
