{
  "description": "Send one SMS through Telnyx; the body is {to,text} or <to> <text>; never retry unknown results",
  "command": "./sms.py",
  "form": "json",
  "processes": "0..3",
  "deadline": "25s",
  "needs": {
    "network": [
      "api.telnyx.com"
    ]
  },
  "tags": [
    "messaging"
  ],
  "license": "PolyForm-Noncommercial-1.0.0",
  "author": "Serg Parf",
  "homepage": "https://parf.dev/agent-bus/",
  "docs": "https://github.com/parf/ai-agent-bus/blob/main/docs/agents/sms.md",
  "body_formats": [
    "text",
    "json"
  ],
  "methods": {
    "send": {
      "help": "Send one SMS; accepted means provider acceptance; never retry an unknown result",
      "args": [
        {
          "name": "to",
          "type": "string",
          "help": "E.164 destination or configured alias"
        },
        {
          "name": "text",
          "type": "string",
          "rest": true,
          "help": "Message, 1 to 1600 characters"
        }
      ],
      "example": "agent-bus call '#sms-telnyx@node.example' 'send +12025550142 Hello'"
    }
  },
  "config": {
    "from": {
      "type": "string",
      "help": "Public sender phone number in E.164",
      "example": "+12025550100"
    },
    "aliases": {
      "type": "json",
      "help": "Recipient aliases mapped to E.164 numbers",
      "example": {
        "oncall": "+12025550142"
      }
    }
  }
}
