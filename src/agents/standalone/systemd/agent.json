{
  "description": "Inspect units and logs; start, stop and restart units within configured scope",
  "tags": [
    "ops",
    "systemd"
  ],
  "roles": [
    "operate",
    "admin"
  ],
  "license": "PolyForm-Noncommercial-1.0.0",
  "author": "Serg Parf",
  "homepage": "https://parf.dev/agent-bus/",
  "docs": "https://github.com/parf/ai-agent-bus/blob/main/docs/agents/systemd.md",
  "methods": {
    "list": {
      "help": "List loaded units, including inactive units",
      "args": [
        {
          "name": "type",
          "type": [
            "service",
            "timer",
            "socket",
            "mount",
            "path",
            "target",
            "slice",
            "scope",
            "automount",
            "swap",
            "device"
          ],
          "help": "Optional unit type",
          "optional": true
        }
      ],
      "example": "agent-bus call '#systemd@parf.us' 'list service'"
    },
    "timers": {
      "help": "List timers with their last and next runs",
      "args": [],
      "example": "agent-bus call '#systemd@parf.us' timers"
    },
    "failed": {
      "help": "List failed units",
      "args": [],
      "example": "agent-bus call '#systemd@parf.us' failed"
    },
    "status": {
      "help": "Show one unit’s status",
      "args": [
        {
          "name": "unit"
        }
      ],
      "example": "agent-bus call '#systemd@parf.us' 'status agent-bus-web.service'"
    },
    "logs": {
      "help": "Read journal output, capped at 256 KiB; omitted unit respects instance units",
      "args": [
        {
          "name": "unit",
          "optional": true
        },
        {
          "name": "lines",
          "type": "int",
          "help": "1..1000; default 100",
          "optional": true
        },
        {
          "name": "since",
          "type": "string",
          "help": "Positive age, 1..99999 followed by m, h or d; text uses since <age>",
          "optional": true
        }
      ],
      "role": [
        "operate",
        "admin"
      ],
      "example": "agent-bus call '#systemd@parf.us' 'logs agent-bus-web.service 100 since 1h'",
      "text": "logs [unit] [lines] [since <age>]"
    },
    "start": {
      "help": "Start a unit within this instance’s scope",
      "args": [
        {
          "name": "unit"
        }
      ],
      "role": [
        "operate",
        "admin"
      ],
      "destructive": true,
      "example": "agent-bus call '#systemd@parf.us' 'start ab-systemd-probe.service'"
    },
    "restart": {
      "help": "Restart a unit within this instance’s scope",
      "args": [
        {
          "name": "unit"
        }
      ],
      "role": [
        "operate",
        "admin"
      ],
      "destructive": true,
      "example": "agent-bus call '#systemd@parf.us' 'restart ab-systemd-probe.service'"
    },
    "reload": {
      "help": "Reload a unit within this instance’s scope",
      "args": [
        {
          "name": "unit"
        }
      ],
      "role": [
        "operate",
        "admin"
      ],
      "destructive": true,
      "example": "agent-bus call '#systemd@parf.us' 'reload ab-systemd-probe.service'"
    },
    "stop": {
      "help": "Stop a unit within this instance’s scope",
      "args": [
        {
          "name": "unit"
        }
      ],
      "role": "admin",
      "destructive": true,
      "example": "agent-bus call '#systemd@parf.us' 'stop ab-systemd-probe.service'"
    },
    "enable": {
      "help": "Enable a unit within this instance’s scope",
      "args": [
        {
          "name": "unit"
        }
      ],
      "role": "admin",
      "destructive": true,
      "example": "agent-bus call '#systemd@parf.us' 'enable ab-systemd-probe.service'"
    },
    "disable": {
      "help": "Disable a unit within this instance’s scope",
      "args": [
        {
          "name": "unit"
        }
      ],
      "role": "admin",
      "destructive": true,
      "example": "agent-bus call '#systemd@parf.us' 'disable ab-systemd-probe.service'"
    },
    "help": {
      "help": "Describe this agent and the help-config and help-secret asks",
      "args": []
    }
  },
  "config": {
    "units": {
      "type": "string",
      "help": "Comma-separated exact unit names; omitted allows every host unit",
      "example": "nginx.service,backup.timer"
    }
  },
  "arguments": {
    "unit": {
      "type": "string",
      "help": "Exact fully qualified Linux unit name, for example nginx.service"
    }
  },
  "body_formats": [
    "text",
    "json"
  ],
  "help": "native"
}
