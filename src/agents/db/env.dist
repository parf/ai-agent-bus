# One account for every caller (only read is then enforced by the database)
DB_USER= # required unless per-tier accounts are set
DB_PASSWORD=
# Per-tier accounts: set any, and a tier without one is refused
DB_READ_USER=
DB_READ_PASSWORD=
DB_WRITE_USER=
DB_WRITE_PASSWORD=
DB_ADMIN_USER=
DB_ADMIN_PASSWORD=
