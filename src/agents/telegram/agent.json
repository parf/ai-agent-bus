{
  "description": "Put your AI in your Telegram chats. Post and read messages, and route replies to the right session. Start with whoami, then post.",
  "command": "./telegram.ts",
  "form": "args",
  "serves": "itself",
  "processes": 1,
  "tags": [
    "messaging"
  ],
  "needs": {
    "network": [
      "api.telegram.org"
    ]
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "author": "Serg Parf",
  "homepage": "https://parf.dev/agent-bus/",
  "docs": "https://github.com/parf/ai-agent-bus/blob/main/docs/agents/telegram.md",
  "methods": {
    "post": {
      "help": "Send a message; without a channel it goes to the configured default. The answer is the chat and message ID.",
      "args": [
        {
          "name": "channel",
          "optional": true
        },
        {
          "name": "reply_to",
          "type": "string",
          "help": "Telegram message ID to reply to (JSON only)",
          "optional": true,
          "json_only": true
        },
        {
          "name": "text",
          "type": "string",
          "help": "Message text",
          "rest": true
        }
      ],
      "returns": "Chat and message ID"
    },
    "read": {
      "help": "Read the messages this bot received, oldest first; without a channel it reads the default.",
      "args": [
        {
          "name": "channel",
          "optional": true
        },
        {
          "name": "limit",
          "type": "int",
          "help": "Number of messages, 1..200; default 20",
          "optional": true
        }
      ]
    },
    "channels": {
      "help": "Find the chats the bot has seen, optionally by part of the name.",
      "args": [
        {
          "name": "filter",
          "type": "string",
          "help": "Chat name substring",
          "optional": true
        }
      ]
    },
    "channel": {
      "help": "See one chat's details.",
      "args": [
        {
          "name": "channel"
        }
      ]
    },
    "users": {
      "help": "Find the senders the bot has seen, optionally by part of the name.",
      "args": [
        {
          "name": "filter",
          "type": "string",
          "help": "Name substring",
          "optional": true
        }
      ]
    },
    "user": {
      "help": "See one sender.",
      "args": [
        {
          "name": "who",
          "type": "string",
          "help": "User ID or @alias"
        }
      ]
    },
    "react": {
      "help": "React to a message.",
      "args": [
        {
          "name": "channel"
        },
        {
          "name": "id",
          "type": "string",
          "help": "Message ID"
        },
        {
          "name": "emoji",
          "type": "string",
          "help": "Telegram-supported emoji"
        }
      ]
    },
    "edit": {
      "help": "Change one of the bot's own messages.",
      "args": [
        {
          "name": "channel"
        },
        {
          "name": "id",
          "type": "string",
          "help": "Message ID"
        },
        {
          "name": "text",
          "type": "string",
          "help": "Replacement text",
          "rest": true
        }
      ],
      "destructive": true
    },
    "delete": {
      "help": "Remove a message when Telegram permits it.",
      "args": [
        {
          "name": "channel"
        },
        {
          "name": "id",
          "type": "string",
          "help": "Message ID"
        }
      ],
      "destructive": true
    },
    "whoami": {
      "help": "See which bot you are talking to and its last polling error, if any.",
      "args": [],
      "example": "agent-bus call '#telegram/parf@parf.us' whoami"
    },
    "refused": {
      "help": "See the last 20 senders turned away by routing and not on the list; direct Owner and Maintainers only.",
      "args": [],
      "role": "maintainer"
    },
    "sub.add": {
      "help": "Forward matching chat messages to a destination; the answer is the subscription ID.",
      "args": [
        {
          "name": "channel"
        },
        {
          "name": "target"
        },
        {
          "name": "filter",
          "type": "string",
          "help": "Regex /pattern/flags or plain regex; empty clears an edited filter",
          "optional": true,
          "rest": true
        }
      ],
      "returns": "Subscription ID",
      "text": "sub add <channel> <target> [filter]"
    },
    "sub.list": {
      "help": "See each subscription with its delivery counters.",
      "args": [],
      "text": "sub list",
      "example": "agent-bus call '#telegram/parf@parf.us' 'sub list'"
    },
    "sub.edit": {
      "help": "Change a subscription; an empty filter= clears its filter.",
      "args": [
        {
          "name": "id",
          "type": "string",
          "help": "Subscription ID"
        },
        {
          "name": "channel",
          "optional": true
        },
        {
          "name": "target",
          "optional": true
        },
        {
          "name": "filter",
          "type": "string",
          "help": "Regex /pattern/flags or plain regex; empty clears an edited filter",
          "optional": true,
          "rest": true
        }
      ],
      "text": "sub edit <id> [channel=…] [target=…] [filter=…]"
    },
    "sub.delete": {
      "help": "Stop forwarding.",
      "args": [
        {
          "name": "id",
          "type": "string",
          "help": "Subscription ID"
        }
      ],
      "destructive": true,
      "text": "sub delete <id>"
    },
    "help": {
      "help": "Show this agent's description and the help-config and help-secret asks.",
      "args": []
    }
  },
  "config": {
    "default": {
      "type": "string",
      "help": "Chat used when a post or read omits its destination",
      "example": "@parf"
    },
    "aliases": {
      "type": "json",
      "help": "@alias or #alias → decimal chat ID string",
      "example": {
        "@parf": "382156160"
      }
    },
    "users": {
      "type": "json",
      "help": "Listed Telegram user ID → bus user",
      "example": {
        "382156160": "parf"
      }
    },
    "tags": {
      "type": "json",
      "help": "Pinned short tag → session agent; generated tags are permanent",
      "example": {
        "b": "#claude/main@parf.us"
      }
    },
    "route": {
      "type": "string",
      "help": "Fallback bus destination for admitted, addressed messages",
      "example": "#claude/main@parf.us"
    },
    "chats": {
      "type": "json",
      "help": "Alias or chat ID → route, tags:false and/or anyone:true; or handler:drop alone to discard incoming messages without history (post still works)",
      "example": {
        "#team": {
          "route": "#claude/main@parf.us",
          "tags": false,
          "anyone": true
        }
      }
    }
  },
  "arguments": {
    "channel": {
      "type": "string",
      "help": "Telegram #alias, @alias or decimal chat ID"
    },
    "target": {
      "type": "string",
      "help": "Bus destination; you must manage it, or be this agent’s direct Owner/Maintainer"
    }
  },
  "body_formats": [
    "text",
    "json"
  ]
}
