{
  "description": "Post and read chats; route your replies to the right session",
  "command": "./telegram.ts",
  "form": "args",
  "serves": "itself",
  "processes": 1,
  "tags": [
    "telegram"
  ],
  "needs": {
    "network": [
      "api.telegram.org"
    ]
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "author": "Serg Parf and agent-bus contributors",
  "homepage": "https://github.com/parf/ai-agent-bus",
  "methods": {
    "post": {
      "help": "Send a message; omitted channel uses the configured default",
      "args": [
        {
          "name": "channel",
          "optional": true
        },
        {
          "name": "reply_to",
          "type": "string",
          "help": "Telegram message ID to reply to (JSON only)",
          "optional": true,
          "json_only": true
        },
        {
          "name": "text",
          "type": "string",
          "help": "Message text",
          "rest": true
        }
      ],
      "returns": "Chat and message ID",
      "example": "agent-bus call '#telegram/parf@parf.us' 'post Hello'"
    },
    "read": {
      "help": "Read messages received by this bot, oldest first; omitted channel uses the default",
      "args": [
        {
          "name": "channel",
          "optional": true
        },
        {
          "name": "limit",
          "type": "int",
          "help": "Number of messages, 1..200; default 20",
          "optional": true
        }
      ]
    },
    "channels": {
      "help": "List chats the bot has seen",
      "args": [
        {
          "name": "filter",
          "type": "string",
          "help": "Chat name substring",
          "optional": true
        }
      ]
    },
    "channel": {
      "help": "Describe one chat",
      "args": [
        {
          "name": "channel"
        }
      ]
    },
    "users": {
      "help": "List senders the bot has seen",
      "args": [
        {
          "name": "filter",
          "type": "string",
          "help": "Name substring",
          "optional": true
        }
      ]
    },
    "user": {
      "help": "Describe a sender",
      "args": [
        {
          "name": "who",
          "type": "string",
          "help": "User ID or @alias"
        }
      ]
    },
    "react": {
      "help": "React to a Telegram message",
      "args": [
        {
          "name": "channel"
        },
        {
          "name": "id",
          "type": "string",
          "help": "Message ID"
        },
        {
          "name": "emoji",
          "type": "string",
          "help": "Telegram-supported emoji"
        }
      ]
    },
    "edit": {
      "help": "Edit the bot’s own message",
      "args": [
        {
          "name": "channel"
        },
        {
          "name": "id",
          "type": "string",
          "help": "Message ID"
        },
        {
          "name": "text",
          "type": "string",
          "help": "Replacement text",
          "rest": true
        }
      ],
      "destructive": true
    },
    "delete": {
      "help": "Delete a message when Telegram permits it",
      "args": [
        {
          "name": "channel"
        },
        {
          "name": "id",
          "type": "string",
          "help": "Message ID"
        }
      ],
      "destructive": true
    },
    "whoami": {
      "help": "Show bot identity and last polling error, if any",
      "args": [],
      "example": "agent-bus call '#telegram/parf@parf.us' whoami"
    },
    "refused": {
      "help": "List the last 20 unlisted routing senders; direct Owner/Maintainers only",
      "args": [],
      "role": "maintainer"
    },
    "sub.add": {
      "help": "Forward matching messages to a destination",
      "args": [
        {
          "name": "channel"
        },
        {
          "name": "target"
        },
        {
          "name": "filter",
          "type": "string",
          "help": "Regex /pattern/flags or plain regex; empty clears an edited filter",
          "optional": true,
          "rest": true
        }
      ],
      "returns": "Subscription ID",
      "text": "sub add <channel> <target> [filter]"
    },
    "sub.list": {
      "help": "Show subscriptions and runtime delivery counters",
      "args": [],
      "text": "sub list"
    },
    "sub.edit": {
      "help": "Update a subscription; empty filter= clears its filter",
      "args": [
        {
          "name": "id",
          "type": "string",
          "help": "Subscription ID"
        },
        {
          "name": "channel",
          "optional": true
        },
        {
          "name": "target",
          "optional": true
        },
        {
          "name": "filter",
          "type": "string",
          "help": "Regex /pattern/flags or plain regex; empty clears an edited filter",
          "optional": true,
          "rest": true
        }
      ],
      "text": "sub edit <id> [channel=…] [target=…] [filter=…]"
    },
    "sub.delete": {
      "help": "Stop forwarding",
      "args": [
        {
          "name": "id",
          "type": "string",
          "help": "Subscription ID"
        }
      ],
      "destructive": true,
      "text": "sub delete <id>"
    },
    "help": {
      "help": "Describe this agent and the help-config and help-secret asks",
      "args": []
    }
  },
  "config": {
    "default": {
      "type": "string",
      "help": "Chat used when a post or read omits its destination",
      "example": "@parf"
    },
    "aliases": {
      "type": "json",
      "help": "@alias or #alias → decimal chat ID string",
      "example": {
        "@parf": "382156160"
      }
    },
    "users": {
      "type": "json",
      "help": "Listed Telegram user ID → bus user",
      "example": {
        "382156160": "parf"
      }
    },
    "tags": {
      "type": "json",
      "help": "Pinned short tag → session agent; generated tags are permanent",
      "example": {
        "b": "#claude/main@parf.us"
      }
    },
    "route": {
      "type": "string",
      "help": "Fallback bus destination for admitted, addressed messages",
      "example": "#claude/main@parf.us"
    },
    "chats": {
      "type": "json",
      "help": "Alias or chat ID → route, tags:false and/or anyone:true; a channel needs a route",
      "example": {
        "#team": {
          "route": "#claude/main@parf.us",
          "tags": false,
          "anyone": true
        }
      }
    }
  },
  "arguments": {
    "channel": {
      "type": "string",
      "help": "Telegram #alias, @alias or decimal chat ID"
    },
    "target": {
      "type": "string",
      "help": "Bus destination; you must manage it, or be this agent’s direct Owner/Maintainer"
    }
  }
}
