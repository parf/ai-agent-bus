#!/bin/bash
# The image's entry point: one role per container (README.md).
#   daemon   agent-busd on its storage volume, serving the port
#   runner   agent-bus-runner for one person, reaching the daemon's port
# Anything else runs as given. Each role runs as its own account, so the
# daemon's and the runner's secrets stay in separate containers and accounts.
set -euo pipefail

# AGENT_BUS_CONTAINER_ROOT only moves the image's directory root, for the entry point's own test.
root=${AGENT_BUS_CONTAINER_ROOT:-/var/lib/agent-bus}
daemon_home=$root/daemon
runner_home=$root/runner
agents=$root/agent.d

fail() { echo "agent-bus-container: $*" >&2; exit 1; }

# A fresh volume is root's: give it to the role's account, never anything
# under it, so a volume from another image is not silently rewritten. A
# directory the account can already use, such as a bind mount of a host
# directory, keeps its owner and mode: changing them would lock its host owner out.
# One that other users can write to is refused, never changed on the host's behalf.
own() { # own DIR ACCOUNT
  local root=0 owner uid
  [ "$(id -u)" != 0 ] || root=1
  owner=$(stat -c %U "$1")
  uid=$(getent passwd "$2" | cut -d: -f3)
  if [ "$owner" != "$2" ]; then
    if usable_by "$2" "$1"; then
      [ $(( 8#$(stat -c %a "$1") & 8#022 )) = 0 ] ||
        fail "$1 is usable by $2 but writable by its group or others, and it holds secrets: make it $2's alone or mode 0700 on the host (rootless podman: podman unshare chown $uid:$uid $1; chmod 0700 $1)"
      return 0
    fi
    # Not usable by the account. Started as the account itself there is no way to take it over; as
    # root only an empty directory, a fresh volume, is: one holding data is somebody's.
    [ "$root" = 1 ] || fail "$1 is not usable by $2, and this start cannot change its owner: start as root, or make it $2's on the host (rootless podman: podman unshare chown $uid:$uid $1)"
    [ -z "$(ls -A "$1")" ] ||
      fail "$1 holds data and is not usable by $2: make it $2's on the host (rootless podman: podman unshare chown $uid:$uid $1)"
    chown "$2:$2" "$1"
  fi
  chmod 0700 "$1"
}

usable_by() { # usable_by ACCOUNT DIR: the account can read, write and enter it
  if [ "$(id -u)" = 0 ]; then
    setpriv --reuid="$1" --regid="$1" --init-groups -- test -r "$2" -a -w "$2" -a -x "$2"
  else
    setpriv --no-new-privs -- test -r "$2" -a -w "$2" -a -x "$2"
  fi
}

as() { # as ACCOUNT COMMAND...
  local who=$1; shift
  if [ "$(id -u)" = 0 ]; then
    # No capability can be kept or regained, and no exec can gain privilege: the image's setuid-root
    # binaries (su, mount, ...) stay inert for the role's processes.
    exec setpriv --reuid="$who" --regid="$who" --init-groups --inh-caps=-all --bounding-set=-all --no-new-privs -- "$@"
  fi
  [ "$(id -un)" = "$who" ] || fail "run as root or as $who, not $(id -un)"
  exec setpriv --no-new-privs -- "$@"
}

case ${1:---help} in
  daemon)
    shift
    own "$daemon_home" agent-busd
    owner=${AGENT_BUS_OWNER:-}
    [ -n "$owner" ] || fail "AGENT_BUS_OWNER names the daemon's Owner, as user@realm"
    db=$daemon_home/agent-bus.db
    # The socket serves this container's own processes, as on an installed node.
    if [ "$(id -u)" = 0 ]; then install -d -m 0711 -o agent-busd -g agent-busd /run/agent-bus; fi
    flags=(--db "$db" --owner "$owner" --addr "${AGENT_BUS_LISTEN:-0.0.0.0:6767}" --socket /run/agent-bus/bus.sock)
    [ ! -d "$daemon_home/tls" ] || flags+=(--tls-dir "$daemon_home/tls")
    if [ -e "$db" ]; then
      echo "agent-bus-container: the Owner is kept from the first start; AGENT_BUS_OWNER is read only then (it is still required, but names no change)" >&2
    else
      # The first start saves the hostname as the realm for good: a container left on its default
      # name, the 12 hex characters of its id, would keep that as its realm.
      ! [[ $(hostname) =~ ^[0-9a-f]{12}$ ]] || fail "the hostname is the realm and is kept from the first start: pass --hostname <name> (the default, $(hostname), is a container id)"
      (as agent-busd agent-busd --init --db "$db" --owner "$owner") || fail "could not create $db"
    fi
    as agent-busd agent-busd "${flags[@]}" "$@"
    ;;
  runner)
    shift
    own "$runner_home" agent-bus-runner
    [ -n "${AGENT_BUS_ADDR:-}" ] || fail "AGENT_BUS_ADDR is the daemon's address, such as http://agent-busd:6767"
    [ -n "${AGENT_BUS_TOKEN:-}" ] || fail "AGENT_BUS_TOKEN is the token of #runner/<person>@<realm>"
    # The container is the boundary and has no sandbox: the image's example
    # runs with it off, said in the inventory a person can read and change.
    # The inventory lists the agents that are present, so a directory mounted over agent.d lists its own.
    if [ ! -e "$runner_home/agents.json" ]; then
      # Every name is checked before anything is written, and the file appears whole or not at all:
      # a half-written agents.json would be taken for the inventory at the next start.
      present=()
      for d in "$agents"/*/; do
        [ -f "${d}agent.json" ] || continue
        case $(basename "$d") in *\"*|*\\*) fail "the agent directory name $(basename "$d") holds a quote or backslash" ;; esac
        present+=("$(basename "$d")")
      done
      sep=""
      tmp=$(mktemp "$runner_home/.agents.json.XXXXXX")
      {
        printf '{\n'
        for name in ${present[@]+"${present[@]}"}; do
          printf '%s  "%s": {"sandbox": "off"}' "$sep" "$name"
          sep=$',\n'
        done
        printf '\n}\n'
      } >"$tmp"
      [ "$(id -u)" != 0 ] || chown agent-bus-runner:agent-bus-runner "$tmp"
      mv "$tmp" "$runner_home/agents.json"
    fi
    as agent-bus-runner agent-bus-runner --host="$runner_home" --agents="$agents" "$@"
    ;;
  --help)
    sed -n '2,6s/^# \{0,1\}//p' "$0"
    ;;
  -*)
    fail "unknown option: $1; use --help"
    ;;
  *)
    exec "$@"
    ;;
esac
