[
 {
  "id": "int64-digits",
  "steps": [
   {
    "op": "set",
    "kind": "int",
    "name": "max",
    "value": "9223372036854775807"
   },
   {
    "op": "get",
    "kind": "int",
    "name": "max",
    "expect": {
     "value": "9223372036854775807"
    }
   },
   {
    "op": "set",
    "kind": "int",
    "name": "min",
    "value": "-9223372036854775808"
   },
   {
    "op": "get",
    "kind": "int",
    "name": "min",
    "expect": {
     "value": "-9223372036854775808"
    }
   },
   {
    "op": "inc",
    "name": "max",
    "by": "1",
    "expect": {
     "refused": {
      "status": 413
     }
    }
   },
   {
    "op": "get",
    "kind": "int",
    "name": "max",
    "expect": {
     "value": "9223372036854775807"
    }
   },
   {
    "op": "inc",
    "name": "count",
    "by": "41"
   },
   {
    "op": "inc",
    "name": "count",
    "by": "1",
    "expect": {
     "value": "42"
    }
   }
  ]
 },
 {
