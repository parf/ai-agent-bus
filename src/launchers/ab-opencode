#!/bin/sh
set -eu
dir=$(dirname "$(readlink -f "$0")")
# A release tree carries the compiled binary beside launchers/; a checkout (its
# go.mod beside them) runs the source with bun, even with a stray binary there.
[ -x "$dir/../agent-bus-ts" ] && [ ! -e "$dir/../go.mod" ] && exec "$dir/../agent-bus-ts" launcher opencode "$@"
command -v bun >/dev/null 2>&1 || { echo 'ab-opencode: install bun to run the launcher' >&2; exit 1; }
entry="$dir/launcher.js"
[ -f "$entry" ] || entry="$dir/launcher.ts"
exec bun "$entry" opencode "$@"
