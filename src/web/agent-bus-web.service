# agent-bus web face: installers replace @WEB_DIR@ with its code directory.
# No state-directory link or writable home.
[Unit]
Description=agent-bus web face (TypeScript)
After=agent-busd.service network.target
Wants=agent-busd.service

[Service]
Type=simple
User=agent-bus-web
Group=agent-bus-web
ExecStart=/usr/bin/bun run @WEB_DIR@/server.ts
WorkingDirectory=@WEB_DIR@
Restart=on-failure
RestartSec=2
UMask=0077

# Only what the face is told.
Environment=AGENT_BUS_ADDR=/run/agent-bus/bus.sock
Environment=AGENT_BUS_WEB_ADDR=127.0.0.1:6780
Environment=BUN_RUNTIME_TRANSPILER_CACHE_PATH=0
Environment=HOME=@WEB_DIR@

# Privilege
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictNamespaces=yes
KeyringMode=private
RemoveIPC=yes
PrivateUsers=yes

# Filesystem: everything read-only; no home, no devices, a private /tmp. The
# code and its VERSION remain readable; the daemon's state, each runner's
# private directory, shared agent code, root's
# home and the host's SSH keys do not exist for it.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
DevicePolicy=closed
InaccessiblePaths=-/var/lib/agent-bus -/root -/etc/ssh
# The one place it may write: with TLS on, its own server listens on a unix
# socket here behind the port's front (docs/08-processes.md#the-web-face).
RuntimeDirectory=agent-bus-web
RuntimeDirectoryMode=0700

# Exec: bun and the five libraries it links (ldd /usr/bin/bun), nothing else.
NoExecPaths=/
ExecPaths=/usr/bin/bun /usr/lib64/ld-linux-x86-64.so.2 /usr/lib64/libc.so.6 /usr/lib64/libm.so.6 /usr/lib64/libdl.so.2 /usr/lib64/libpthread.so.0

# Kernel
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid

# System calls
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @mount @debug @cpu-emulation @obsolete @raw-io @reboot @swap
SystemCallErrorNumber=EPERM

# Network: answers on loopback, connects out to nothing.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost

# Resources
MemoryMax=256M
MemorySwapMax=0
TasksMax=64
CPUQuota=100%
LimitNOFILE=1024

[Install]
WantedBy=multi-user.target
