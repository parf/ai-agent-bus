/src/agent-bus
/src/agent-busd
# The rest of the five. A tracked binary shadows the fresh build, and a stale
# one reads as a passing result — which is exactly how it went unnoticed.
/src/agent-bus-setup
/src/agent-bus-admin
/src/agent-bus-token
/src/agent-bus-web
# Scratch space, and the two ways to name something that is not ours to keep.
# tmp/ is where temp data and one-off scripts go; anything else throwaway
# carries .local in its name or sits in a local/ directory.
tmp/
local/
*.local
*.local.*
/src/mcp/node_modules/
/src/*.test
/src/**/*.test

# A TLS private key is never ours to publish, and localhost.direct's is
# revoked the moment one appears in a repo (docs/05-discovery.md#dashboard).
*.key
*.crt
*.pem
