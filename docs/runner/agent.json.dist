{
  "description": "Fetches one mailbox and answers with what is new",
  "version": "1.2.0",
  "command": "./fetch.sh --quiet",
  "form": "args",
  "asks": "none",
  "serves": "runner",
  "processes": "0..3",
  "deadline": "30s",
  "idle": "5m",
  "in_flight": 1,
  "tags": [
    "mail"
  ],
  "roles": [
    "reader"
  ],
  "depends": [
    "#vault@your-realm"
  ],
  "needs": {
    "network": [
      "imap.example.com"
    ],
    "memory": "256M",
    "writable": [
      "cache"
    ]
  },
  "license": "MIT",
  "author": "Example author",
  "homepage": "https://example.com/mail",
  "methods": {
    "fetch": {
      "help": "Fetch mail",
      "args": [
        {
          "name": "folder",
          "optional": true
        },
        {
          "name": "limit",
          "help": "Maximum messages, 1..50",
          "type": "int",
          "optional": true,
          "json_only": true,
          "default": 20
        },
        {
          "name": "query",
          "help": "Search words",
          "type": "string",
          "optional": true,
          "rest": true
        }
      ],
      "returns": "New messages",
      "role": "reader",
      "text": "fetch [folder] [query...]",
      "type": "json",
      "destructive": false,
      "example": "agent-bus call '#work-mail@your-realm' fetch INBOX 'from:team'"
    }
  },
  "config": {
    "folder": {
      "help": "Default folder",
      "type": "string",
      "example": "INBOX",
      "default": "INBOX"
    }
  },
  "body_formats": [
    "text",
    "json"
  ],
  "arguments": {
    "folder": {
      "help": "Folder to fetch",
      "type": "string",
      "default": "INBOX"
    }
  }
}
