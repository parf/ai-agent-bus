{
  "description": "Fetches one mailbox and answers with what is new",
  "version": "1.2.0",
  "command": "./fetch.sh --quiet",
  "form": "args",
  "serves": "runner",
  "processes": "0..3",
  "deadline": "30s",
  "idle": "5m",
  "in_flight": 1,
  "tags": [
    "mail"
  ],
  "roles": [
    "reader"
  ],
  "depends": [
    "#vault@your-realm"
  ],
  "needs": {
    "network": [
      "imap.example.com"
    ],
    "memory": "256M",
    "writable": [
      "cache"
    ]
  },
  "license": "MIT",
  "author": "Example author",
  "homepage": "https://example.com/mail",
  "methods": {
    "fetch": {
      "help": "Fetch mail",
      "args": [
        {
          "name": "folder",
          "help": "Folder to fetch",
          "optional": true
        }
      ],
      "returns": "New messages",
      "role": "reader"
    }
  },
  "config": {
    "folder": {
      "help": "Default folder",
      "type": "string",
      "example": "INBOX"
    }
  }
}
